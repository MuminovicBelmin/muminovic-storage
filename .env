# Verify these two OVH values against the actual bucket region before first start.
# The current values target OVH Gravelines (gra).
OVH_S3_REGION=gra
OVH_S3_HOST=s3.gra.io.cloud.ovh.net

NEXTCLOUD_IMAGE=nextcloud:33.0.2-apache
MARIADB_IMAGE=mariadb:lts
VALKEY_IMAGE=valkey/valkey:8.1.6-alpine

NEXTCLOUD_HOSTNAME=storage.muminovic.devotus.eu
NEXTCLOUD_ADMIN_USER=ncadmin

NC_DB_NAME=nextcloud_muminovic
NC_DB_USER=nextcloud_muminovic

OVH_S3_BUCKET=muminovic-storage